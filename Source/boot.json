{
    "name": "[SmartPhone Alpha] 万能的智能手机 尝鲜版  - 本版本处于尝鲜版本，各种剧情和设定不够完善，敬请期待后续更新。",
    "version": "Alpha.2.97",
    "styleFileList": ["style.css"],
    "scriptFileList": ["scripts/vars.js", "scripts/api.js", "scripts/apps.js", "scripts/main.js"],
    "tweeFileList": ["twee/phone.twee", "twee/phone_call.twee", "twee/phone_game.twee", "twee/phone_passage.twee"],
    "imgFileList": [
        "img/misc/icon/phone/phone.png",
        "img/misc/icon/phone/phones.png",
        "img/misc/icon/phone/phone_disabled.png",
        "img/misc/icon/phone/phone_forbid.png",
        "img/misc/icon/phone/phone_crack.png",
        "img/misc/icon/phone/live.png",
        "img/misc/locations/phone/base.png",
        "img/ui/phone/battery.png",
        "img/ui/phone/battery_bg.png",
        "img/ui/phone/home.png",
        "img/ui/phone/lock.png",
        "img/misc/icon/phone/app/yenote.png"
    ],
    "additionFile": ["README.md"],
    "addonPlugin": [
        {
            "modName": "ModLoader DoL ImageLoaderHook",
            "addonName": "ImageLoaderAddon",
            "modVersion": "^2.3.0",
            "params": []
        },
        {
            "modName": "TweeReplacer",
            "addonName": "TweeReplacerAddon",
            "modVersion": "1.0.0",
            "params": [
                {
                    "passage": "Characteristics",
                    "findString": "<<set _skulduggeryConfig =",
                    "replace": "<<set _photographyConfig =\t{ name : \"Photography\", cn_name:\"摄像\", displayType : \"grade\",\tcurrentValue : $Phone.photography,\t\tmodifier: 100, modTypes: { good: [], bad: [] },\t\tstates : _detailedSkillGrades}>>\n<<set _skulduggeryConfig ="
                },
                {
                    "passage": "Characteristics",
                    "findString": "<<characteristic-box _housekeepingConfig>>",
                    "replace": "<<characteristic-box _housekeepingConfig>>\n<<characteristic-box _photographyConfig>>"
                },
                {
                    "passage": "Widgets Journal",
                    "findString": "<<if _carrying or _hasProduce>>",
                    "replace": "<<if _carrying or _hasProduce or $Phone.Owned>>",
                    "all": true
                },
                {
                    "passage": "Clothing Shop v2 Widgets",
                    "findString": "<<elseif (Time.dayState is \"night\" and $shopName isnot \"forest\") or _shopCloseOverride>>",
                    "replace": "<<elseif $location isnot \"phone\" and ((Time.dayState is \"night\" and $shopName isnot \"forest\") or _shopCloseOverride)>>"
                }
            ]
        }
    ],
    "dependenceInfo": [
        {
            "modName": "ModLoader",
            "version": "^2.31.2"
        },
        {
            "modName": "GameVersion",
            "version": "=0.5.7.9"
        },
        {
            "modName": "ModLoader DoL ImageLoaderHook",
            "version": "^2.3.0"
        },
        {
            "modName": "TweeReplacer",
            "version": "^1.0.0"
        }
    ]
}