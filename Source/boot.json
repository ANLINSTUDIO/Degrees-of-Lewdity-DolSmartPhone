    "addonPlugin": [
        {
            "modName": "ModLoader DoL ImageLoaderHook",
            "addonName": "ImageLoaderAddon",
            "modVersion": "^2.3.0",
            "params": []
        },
        {
            "modName": "TweeReplacer",
            "addonName": "TweeReplacerAddon",
            "modVersion": "1.0.0",
            "params": [
                {
                    "passage": "Characteristics",
                    "findString": "<<set _skulduggeryConfig =",
                    "replace": "<<set _photographyConfig =\t{ name : \"Photography\", cn_name:\"摄影\", displayType : \"grade\",\tcurrentValue : $Phone.photography,\t\tmodifier: 100, modTypes: { good: [], bad: [] },\t\tstates : _detailedSkillGrades}>>\n<<set _skulduggeryConfig ="
                },
                {
                    "passage": "Characteristics",
                    "findString": "<<characteristic-box _housekeepingConfig>>",
                    "replace": "<<characteristic-box _housekeepingConfig>>\n<<characteristic-box _photographyConfig>>"
                },
                {
                    "passage": "Widgets Journal",
                    "findString": "<<if _carrying or _hasProduce>>",
                    "replace": "<<if _carrying or _hasProduce or $Phone.Owned>>",
                    "all": true
                },
                {
                    "passage": "Clothing Shop v2 Widgets",
                    "findString": "<<elseif (Time.dayState is \"night\" and $shopName isnot \"forest\") or _shopCloseOverride>>",
                    "replace": "<<elseif $location isnot \"phone\" and ((Time.dayState is \"night\" and $shopName isnot \"forest\") or _shopCloseOverride)>>"
                }
            ]
        }
    ],
    "dependenceInfo": [
        {
            "modName": "ModLoader",
            "version": "^2.31.2"
        },
        {
            "modName": "GameVersion",
