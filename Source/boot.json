    "addonPlugin": [
        {
            "modName": "BeautySelectorAddon",
            "addonName": "BeautySelectorAddon",
            "modVersion": "^2.0.0",
            "params": {
                "type": "万能的智能手机 SmartPhone"
            }
        },
        {
            "modName": "TweeReplacer",
            "addonName": "TweeReplacerAddon",
            "modVersion": "1.0.0",
            "params": [
                {
                    "passage": "Options Overlay",
                    "findString": "<<if $passage isnot \"Start\">>",
                    "replaceFile": "twee/game/overlays/Settings.twee"
                },
                {
                    "passage": "Characteristics",
                    "findString": "<<set _skulduggeryConfig =",
                    "replace": "<<set _photographyConfig =\t{ name : \"Photography\", cn_name:\"摄影\", displayType : \"grade\",\tcurrentValue : $Phone.photography,\t\tmodifier: 100, modTypes: { good: [], bad: [] },\t\tstates : _detailedSkillGrades}>>\n<<set _skulduggeryConfig ="
                },
                {
                    "passage": "Characteristics",
                    "findString": "_housekeepingConfig>>",
                    "replace": "_housekeepingConfig>>\n<<characteristic-box _photographyConfig>>"
                },
                {
                    "passage": "Widgets Journal",
                    "findString": "<<if _carrying or _hasProduce>>",
                    "replace": "<<if _carrying or _hasProduce or ($Phone.Owned and $Phone.Owned.length gt 0)>>",
                    "all": true
                },
                {
                    "passage": "Clothing Shop v2 Widgets",
                    "findString": "<<elseif (Time.dayState is \"night\" and $shopName isnot \"forest\") or _shopCloseOverride>>",
                    "replace": "<<elseif $location isnot \"phone\" and ((Time.dayState is \"night\" and $shopName isnot \"forest\") or _shopCloseOverride)>>"
                },
                {
                    "passage": "School Lockers Sneak",
                    "findString": "<<addinlineevent \"KylarLocker\" 0.015>>",
                    "replace": "<<addinlineevent \"KylarLocker\" 0.015>><<run PhoneMod.SchoolLockersSneakOnNPC(\"Kylar\")>>"
                },
                {
                    "passage": "School Lockers Sneak",
                    "findString": "<<addinlineevent \"WhitneyLocker\" 0.015>>",
                    "replace": "<<addinlineevent \"WhitneyLocker\" 0.015>><<run PhoneMod.SchoolLockersSneakOnNPC(\"Whitney\")>>"
                },
                {
                    "passage": "School Lockers Sneak",
                    "findString": "<<addinlineevent \"RobinLocker\" 0.015>>",
                    "replace": "<<addinlineevent \"RobinLocker\" 0.015>><<run PhoneMod.SchoolLockersSneakOnNPC(\"Robin\")>>"
                },
                {
                    "passage": "School Lockers Sneak",
                    "findString": "<<addinlineevent \"SydneyLocker\" 0.015>>",
                    "replace": "<<addinlineevent \"SydneyLocker\" 0.015>><<run PhoneMod.SchoolLockersSneakOnNPC(\"Sydney\")>>"
                },
                {
                    "passage": "Widgets Home",
                    "findString": "<<widget \"generateSleepLinks\">>",
                    "replace": "<<widget \"generateSleepLinks\">><<print PhoneMod.checkAlarmsInSleepText()>>"
                },
                {
                    "passage": "Widgets Sleep",
                    "findString": "<<set $sleephour -= 1>>",
                    "replaceFile": "twee/game/sleepAlarm/sleepAlarmTest.twee"
                },
                {
                    "passage": "Sleep",
                    "findString": "$daily.motherWake is 1>>",
                    "replaceFile": "twee/game/sleepAlarm/sleepAlarmWake.twee",
                    "all": true
                },
                {
                    "_comment1": "添加新NPC-老冯 参考模拟人生的代码",
                    "passage": "npcNamed",
                    "findString": "\t<<for _i to 0; _i lt $NPCName.length; _i++>>",
                    "replaceFile": "twee/game/npc/Feng_0.twee"
                },
                {
                    "passage": "npcNamed",
                    "findString": "\t\t\t\"zephyr\": {nam : \"Zephyr\", title: \"captain\", insecurity: \"skill\", adult: 1}",
                    "replaceFile": "twee/game/npc/Feng_1.twee"
                },
                {
                    "passage": "npcNamed",
                    "findString": "\t\t\t<<case \"Zephyr\">>",
                    "replaceFile": "twee/game/npc/Feng_2.twee"
                },
                {
                    "passage": "npcNamed",
                    "findString": "\t\t<<case \"Gwylan\" \"Zephyr\">>",
                    "replaceFile": "twee/game/npc/Feng_3.twee"
                },
                {
                    "passage": "Widgets variablesStatic",
                    "findString": "\t<<run initCNPC()>>",
                    "replaceFile": "twee/game/npc/Feng_4.twee"
                },
                {
                    "passage": "Widgets variablesVersionUpdate",
                    "findString": "\t\t<<for _npc range [\"avery\", \"bailey\", \"charlie\", \"darryl\", \"doren\", \"eden\", \"gwylan\", \"harper\", \"jordan\", \"kylar\", \"landry\", \"leighton\", \"mason\", \"morgan\", \"river\", \"robin\", \"sam\", \"sirris\", \"whitney\", \"winter\", \"zephyr\"]>>",
                    "replaceFile": "twee/game/npc/Feng_5.twee"
                },
                {
                    "passage": "Social",
                    "findString": "\t\t\t\t\t\"Zephyr\" : {",
                    "replaceFile": "twee/game/npc/Feng_7.twee"
                },
                {
                    "passage": "Widgets",
                    "findString": "\t<<set _i to $NPCNameList.indexOf(\"Zephyr\")>>",
                    "replaceFile": "twee/game/npc/Feng_8.twee"
                },
                {
                    "passage": "Widgets Named Npcs",
                    "findString": "\t\t<!-- Default cases -->",
                    "replaceFile": "twee/game/npc/Feng_9.twee"
                }
            ]
        }
    ],
