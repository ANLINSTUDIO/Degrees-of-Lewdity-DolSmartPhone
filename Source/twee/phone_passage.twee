:: =======StoringPhone========
:: Bedroom Store Phone
将手机安全的保存起来，减少身上的空间占用。存放的手机不会消耗电量。<br><br>
<<set _store to PhoneMod.getPhonesStoreIn("Bedroom")>>
<<for _Phone range _store>>
    <<capture _Phone>>
        <<set _info to PhoneMod.getPhoneConditionInfo(_Phone)>>
        <<if _Phone.stolen and !_Phone.usable>>
            <<icon "phone/phone_forbid.png">>
        <<else>>
            <<icon "phone/phone_disabled.png">> 
        <</if>>
        <<link [[取出|Bedroom Store Phone]]>> <<run PhoneMod.PhoneStoreFinish("Bedroom", _Phone.id)>> <</link>>
        <<if _Phone.newnessmax gt 0>>
            <<print '[ '+PhoneMod.getPhoneBattery(_Phone)+'% ] '>>
        <<else>>
            [ --- ] 
        <</if>>
        <<print '一部'+_info.html+'的 '+_Phone.model+' ，官网售价为<span class="gold">£'+Math.round(PhoneMod.getPhoneInfo(_Phone.model).price)+'</span>。'>>
        <<if _Phone.stolen>>
            <span class='red'>盗窃得来</span>
            <<if _Phone.usable>>
                <span class='yellow'>密码已重置</span>
            <<else>>
                <span class='red'>密码未知</span>
            <</if>>
        <<else>>
            <<if _Phone.second>>
                <span class='yellow'>地下手机店购买</span>
            <<else>>
                <span class='green'>官方渠道购买</span>
            <</if>>
        <</if>><br>
    <</capture>>
<</for>><br>
<<for _Phone range $Phone.Owned>>
    <<capture _Phone>>
        <<set _info to PhoneMod.getPhoneConditionInfo(_Phone)>>
        <<if $Phone.Using and _Phone.id eq $Phone.Using>>
            <<icon "phone/phone.png">>
        <<elseif _Phone.stolen and !_Phone.usable>>
            <<icon "phone/phone_forbid.png">>
        <<else>>
            <<icon "phone/phone_disabled.png">> 
        <</if>>
        <<link [[存放|Bedroom Store Phone]]>> <<run PhoneMod.PhoneStore("Bedroom", _Phone.id)>> <</link>>
        <<if _Phone.newnessmax gt 0>>
            <<print '[ '+PhoneMod.getPhoneBattery(_Phone)+'% ] '>>
        <<else>>
            [ --- ] 
        <</if>>
        <<print '一部'+_info.html+'的 '+_Phone.model+' ，官网售价为<span class="gold">£'+Math.round(PhoneMod.getPhoneInfo(_Phone.model).price)+'</span>。'>>
        <<if _Phone.stolen>>
            <span class='red'>盗窃得来</span>
            <<if _Phone.usable>>
                <span class='yellow'>密码已重置</span>
            <<else>>
                <span class='red'>密码未知</span>
            <</if>>
        <<else>>
            <<if _Phone.second>>
                <span class='yellow'>地下手机店购买</span>
            <<else>>
                <span class='green'>官方渠道购买</span>
            <</if>>
        <</if>><br>
    <</capture>>
<</for>>
<br><br>
<<bedicon>><<link [[卧室|Bedroom]]>><</link>><br>




