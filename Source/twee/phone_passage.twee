:: ============DD============ [widget]
<<widget "ddinfo">>
    您需要亲自前往最近的可停车地点，您的专属司机会在那里等着您，
    <<ddwaittimeinfo>>
    否则全额支付等待费<span class="gold">£<<print PhoneMod.DD等待全额费用>></span>。<br>
<</widget>>
<<widget "ddwaittimeinfo">>
    等待时间 <span class="green">前<<print PhoneMod.DD免费等待时间>>分钟免费</span>，<span class="red">不超过<<print PhoneMod.DD最大等待时间>>分钟</span>，
<</widget>>
<<widget "ddlocationinfo">>
    <<print '您在 <span class="green">'+$location+'</span>，最近的可停车地点为：<span class="red">'+PhoneMod.ddGetTheNearestBoardingPoint().name+'</span> 。'>><br>
<</widget>>
<<widget "ddlocationinfodestination">>
    <<print '您在 <span class="green">'+$location+'</span>，请立刻前往最近的可停车地点：<span class="red">'+PhoneMod.ddGetTheNearestBoardingPoint().name+'</span> ，本次出行的目的地是 <span class="teal">'+PhoneMod.ddGetDestinationName()+'</span> 。'>><br>
<</widget>>
<<widget "ddcostinfo">>
    您预计支付：<<print '<span class="gold">£'+PhoneMod.ddCalculateFare()+'</span>'>>。<br>
<</widget>>
<<widget "phone_app_DD">>
    <h2>DD打车</h2>
    <<set _theNearestBoardingPoint to PhoneMod.ddGetTheNearestBoardingPoint()>>
    <<if $Phone.ddcanceled>>
        <span class="red">订单已取消</span> <br>
        <<print $Phone.ddcanceled>><br>
        <<if $Phone.ddcost>>
            你需要为司机的等待支付 <span class="gold">£<<print $Phone.ddcost>></span>。
        <</if>>
        <br><br><<link "确认">><<run PhoneMod.ddCancelChecked()>><</link>><br>
    <<elseif PhoneMod.ddIsSubmited()>>
        请前往您的上车点。<br>
        <<ddlocationinfodestination>>
        <<ddcostinfo>>
        现在已经等待了<span class="yellow"><<print PhoneMod.ddGetWaitTime()>>分钟</span>。<br>
        <<ddinfo>><br>
        <<icon "phone/app/DD.png">><<link "取消叫车">><<run PhoneMod.ddCancel('用户取消了订单')>><</link>><br>
    <<elseif $Phone.dd>>
        <<ddlocationinfodestination>>
        <<ddcostinfo>>
        <<ddinfo>><br>
        <<if $money lt PhoneMod.ddCalculateFare()*100>>
            <span class="red">你支付不起这个金额。</span>
        <<elseif $money lt PhoneMod.DD等待全额费用*100>>
            <span class="red">你支付不起最大等待费定价。</span>
        <<else>>
            <<icon "phone/app/DD.png">><<link "确定叫车">><<run PhoneMod.ddSubmit()>><</link>>
        <</if>><br>
        <<getouticon>><<link 取消>><<run PhoneMod.ddSetDestination()>><</link>><br>
    <<elseif _theNearestBoardingPoint>>
        请确认您的目的地。<br>
        <<ddlocationinfo>>
        <<ddinfo>>

        <<for _region, _destinations range PhoneMod.getAllBoardingPoints()>>
            <<set _pass to 1>>
            <<if _region is "森林" and !($town_projects.road gte 4)>>
                <<set _pass to 0>>
            <</if>>
            <<if _pass>>
                <<print '<br>'+_region+'<br>'>>
                <<for _destination range _destinations>>
                    <<if _destination.current>>
                        <<print '<<'+_destination.icon+'>>'+_destination.name+' | <span class="green">当前最近的可停车地点</span><br>'>>
                    <<else>>
                        <<print '<<'+_destination.icon+'>><<link "'+_destination.name+'">><<run PhoneMod.ddSetDestination("'+_destination.key+'")>><</link>><br>'>>
                    <</if>>
                <</for>>
            <</if>>
        <</for>>
    <<else>>
        <div style="width: 100%;height: 80%;text-align: center;display: flex;flex-direction: column;align-items: center;justify-content: center;">
            <img src="img\misc\icon\prison_run.png">
            当前所在的位置暂不支持DD打车服务。<br>
            <span class="black">当前位置信号差，请移步空旷地带再重新试试呢……</span>
        </div>
    <</if>>
<</widget>>

