    <<set C.npc.Feng.lust += 1>>
    <<note "+ 老冯的欣赏" "green">>
<</widget>>
<<widget "ggfenglust">>
    <<set C.npc.Feng.lust += 2>>
    <<note "++ 老冯的欣赏" "green">>
<</widget>>
<<widget "gggfenglust">>
    <<set C.npc.Feng.lust += 3>>
    <<note "+++ 老冯的欣赏" "green">>
<</widget>>
<<widget "lfenglust">>
    <<set C.npc.Feng.lust -= 1>>
    <<note "- 老冯的欣赏" "red">>
