:: ==========Charge========== [widget]
<<widget "charge">>
    <<set _UnguardedCharge to PhoneMod.isPhoneChargeUnguardedIn(_args[0], true)>>
    <<if _UnguardedCharge>>
        <<set _UnguardedChargePhone to _UnguardedCharge.phone>>
        <<set _UnguardedChargeHours to _UnguardedCharge.fromStarted>>
        <<if _UnguardedCharge.beenStolen>>
            你记得你把你<<print PhoneMod.getPhoneConditionInfo(_UnguardedChargePhone).html>>的 <<print _UnguardedChargePhone.model>> 放在这里充电来着， <span class="red">但是你找不到它了</span> ！<br><br>
            你的手机被盗，而且你还找不到是谁偷的。<br><br>
        <<else>>
            你把你<<print PhoneMod.getPhoneConditionInfo(_UnguardedChargePhone).html>>的 <<print _UnguardedChargePhone.model>> 放在这里充电。
            <<if PhoneMod.getPhoneBattery(_UnguardedChargePhone) is null>>
                <span class="red">但是好像看样子它的状态不太好</span>，明明是充电，但是已经开不了机了。你怀疑是不是充的太久了，它没有爆炸就算好的了。
                <<if _UnguardedChargeHours>>
                    <br><br>
                    你的手机已经充了 <<print _UnguardedCharge.fromStartedText>> 的电。<<phonewear _UnguardedCharge.wear>>
                <</if>>
            <<else>>
                当前的电量是<<print PhoneMod.getPhoneBattery(_UnguardedChargePhone)>>%。
                <<if _UnguardedChargeHours>>
                    <br><br>
                    你的手机已经充了 <<print _UnguardedCharge.fromStartedText>> 的电。
                    <<print '<<phonecharge _UnguardedChargePhone '+PhoneMod.充电速度每小时*_UnguardedChargeHours+'>>'>>
                    <<phonewear _UnguardedCharge.wear>>
                <</if>>
            <</if>><br><br>
            <<link [[把放在这里充电的手机拿走|_args[1]]]>><<run PhoneMod.PhoneChargeUnguardedFinish(_args[0])>><</link>><br>
        <</if>>
    <<else>>
        <<set _phone to PhoneMod.getUsingPhone()>>
        <<if _phone>>
            你<<print PhoneMod.getPhoneConditionInfo(_phone).html>>的 <<print _phone.model>> 可以在这里充电。当前的电量是<<print PhoneMod.getPhoneBattery(_UnguardedChargePhone)>>%。<br><br>
            <<link [[把手机放在这里充电|_args[1]]]>><<run PhoneMod.PhoneChargeUnguarded(_args[0])>><</link>>
            <<if $Phone.PowerBank>>
                <br><<icon "phone/power_bank.png">> <<link [[为充电宝充电|_args[1]]]>><<run PhoneMod.PowerBankChargeIn()>><</link>>
            <</if>>
            <br><br>
            <<link [[守着充电5分钟 (0:05)|_args[1]]]>><<pass 5>><<run PhoneMod.PhoneCharge(PhoneMod.充电速度每小时/12)>><</link>> <<phonecharge _phone PhoneMod.充电速度每小时/12>><br>
            <<link [[守着充电10分钟 (0:10)|_args[1]]]>><<pass 10>><<run PhoneMod.PhoneCharge(PhoneMod.充电速度每小时/6)>><</link>> <<phonecharge _phone PhoneMod.充电速度每小时/6>><br>
            <<link [[守着充电30分钟 (0:30)|_args[1]]]>><<pass 30>><<run PhoneMod.PhoneCharge(PhoneMod.充电速度每小时/2)>><</link>> <<phonecharge _phone PhoneMod.充电速度每小时/2>><br>
            <<link [[守着充电1小时 (1:00)|_args[1]]]>><<pass 60>><<run PhoneMod.PhoneCharge(PhoneMod.充电速度每小时)>><</link>> <<phonecharge _phone PhoneMod.充电速度每小时>><br>
        <<else>>
            这里有地方可以为你的手机充电，但是你得先有一台可用的手机。
        <</if>>
    <</if>>
<</widget>>
<<widget "phonecharge">>
    <<if _args.length gt 0>>
        <<set _charge to Math.round(eval(_args[1])/_args[0].newnessmax*100)>>
        <<note "+_charge%" "green">>
    <</if>>
<</widget>>
<<widget "phonewear">>
    <<if _args.length gt 0 and _args[0] gt 0>>
        <<set _wear to Math.round(_args[0])>>
        <<note "+_wear手机损耗" "red">>
    <</if>>
