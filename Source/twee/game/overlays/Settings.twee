<hr>
	<div class="settingsGrid">
		<div class="settingsHeader options">万能的智能手机模组设置</div>
		<div class="settingsToggleItemWide">
			手机缩放
			<br>
			<<set _PhoneScale to $Phone.Settings.Scale ?? 1.0>>
			<<numberslider "_PhoneScale" _PhoneScale 0.3 2.00 0.01>>
			<br>
			<input type="button" value="设置" onclick='PhoneMod.PhoneScaleSettings()'/>
			<input type="button" value="重设" onclick='PhoneMod.PhoneScaleSettingsReset()'/>
		</div>
	</div>

	<<if $passage isnot "Start">>