:: Phone Back
你放下了手机。<br><br>
<<link [[继续|$Phone.ReturnPassage]]>>
    <<run PhoneMod.PhoneBack()>>
<</link>>
<<print '<<goto "'+PhoneMod.PhoneBack()+'">>'>>

:: SmartPhonePreviewWidgets [widget]
<<widget "smartphone_render_preview">>
    <div id="smart-phone-container" class="phone-main" onclick="if(!this.classList.contains('phone-open')) PhoneMod.togglePhone()">
        <div class="phone-screen-locked">
            <div style="font-size: 16px; font-weight: bold;">
                你好👋
            </div>
        </div>

        <div class="phone-screen-unlocked" onclick="event.stopPropagation()">
            <div id="phone-content" class="phone-content phone-content-open" style="overflow-x: hidden;">
                <<if PhoneMod.getIsLatestVersion()>>
                    <h2 class="green">已是最新版本🥳</h2>
                    <<print '<span class="black">当前版本 '+PhoneMod.currentVersion+'</span>'>><br>
                    <<print '<span id="phone-notice" class="black">'+PhoneMod.notice+'</span>'>>
                    <div style="text-align: start;" 
                    data-remote="https://sb.alseece.top/2/value.php?key=DoL-SmartPhone-Notice"
                    data-replace="true">正在获取公告</div>
                <<else>>
                    <div>
                        <h2 class="pink"><a class="link-external pink" href="https://sb.alseece.top/2?=DoL-SmartPhone" target="_blank">点我更新到最新版本😘</a></h2>
                        <<print '<span class="black">当前版本 '+PhoneMod.currentVersion+'</span>'>><br>
                        <<print '<span class="hypno-text hypno">'+PhoneMod.latestVersion+' 贴近你的耳边对你说：“来呀~来呀~”</span>'>><br>
                        <div style="text-align: start;" class="jitter-text jitter-1"
                        data-remote="https://sb.alseece.top/2/value.php?key=DoL-SmartPhone-Notice"
                        data-replace="true">正在获取公告</div>
                    </div>
                <</if>>
                <<run AsAPI.loadRemote()>>
                <hr>
                <h1>万能的智能手机 <span class="teal">尝鲜版</span></h1>
                <h3>你好丫~ 感谢<b style="color: pink;">聪明可爱又大方</b>的你的支持哦</h3>
                <hr>
                <div>
                    我是<a href="https://alseece.top/5420/" class="link-external gold" target="_blank">𝑨𝑵𝑳𝑰𝑵. STUDIO</a>👋，温馨提示你：<br>
                    本模组完全免费，且开源于<a class="link-external" href="https://github.com/ANLINSTUDIO/Degrees-of-Lewdity-DolSmartPhone" target="_blank">GitHub</a>。如果你是通过付费渠道下载的此版本，请立刻举报。⚠️⚠️⚠️<br>
                    当前处于<span class="teal">尝鲜版本</span>，各种剧情和设定不够完善。如果你有任何意见和建议，或者想要参与到开发中来，欢迎在<a class="link-external" href="https://tieba.baidu.com/p/10483351324">我的贴子</a>下面留言！<br>
                    <br>
                    在此模组中，玩家一旦拥有智能手机，便可以设定定时闹钟提醒、拨打部分角色的电话、玩游戏、开通社交账号发布照片、网购、拍摄进攻者的照片进行勒索等以及触发更多有关手机的随机事件。<br>
                    <br>
                    更多功能，请参阅<a class="link-external" href="https://github.com/ANLINSTUDIO/Degrees-of-Lewdity-DolSmartPhone?tab=readme-ov-file#readme" target="_blank">GitHub上的说明文档</a>。
                </div>
            </div>
            <div class="phone-tool-bar">
                <span onclick="PhoneMod.togglePhone()" style="cursor:pointer">
                    <img class="toolbar-icon" src="img/ui/phone/lock.png">
                </span>
            </div>
        </div>
    </div>
<</widget>>

:: SmartPhoneWidgets [widget]
<<widget "smartphone_render">>
    <div id="smart-phone-container" class="phone-main" onclick="if(!this.classList.contains('phone-open')) PhoneMod.togglePhone()">
        <div class="phone-screen-locked">
            <div style="font-size: 16px; font-weight: bold;">
                <<if !($Phone.Using is "null") and PhoneMod.getUsingPhone().newness gt 0>>
                    <<print PhoneMod.getTimeString()>>
                    <div id="battery">
                        <img id="battery_bg" src="img/ui/phone/battery_bg.png">
                        <<set _battery to PhoneMod.getPhoneBattery()>>
                        <<print '<img id="battery_cover" src="img/ui/phone/battery.png" style="clip-path: inset(0 '+(100 - _battery)+'% 0 0);">'>>
                        <<print '<span id="battery_value">'+_battery+'</span>'>>
                    </div>
                <</if>>
            </div>
        </div>
        
        <div class="phone-screen-unlocked" onclick="event.stopPropagation()">
            <<if $Phone.AlarmTriggered is true>>
                <div class="phone-alarming">
                    <<phone_wallpaper>>
                    <div style="font-size: 32px; font-weight: bold;">
                        <<if $Phone.AlarmCurrent.hour < 10>>0<</if>>$Phone.AlarmCurrent.hour:<<if $Phone.AlarmCurrent.minute < 10>>0<</if>>$Phone.AlarmCurrent.minute
                    </div>
                    <p>$Phone.AlarmCurrent.msg</p>
                    <<button "关闭闹钟">><<run PhoneMod.cancelAlarm()>><</button>>
                </div>
            <<else>>
                <div class="phone-status-bar">
                    <span><<print PhoneMod.getTimeString()>></span>
                    <span style="flex-grow: 1;"></span>
                    <<print Weather.toSelectedString(Weather.temperature, 1)>>
                    <div id="battery">
                        <img id="battery_bg" src="img/ui/phone/battery_bg.png">
                        <<set _battery to PhoneMod.getPhoneBattery()>>
                        <<print '<img id="battery_cover" src="img/ui/phone/battery.png" style="clip-path: inset(0 '+(100 - _battery)+'% 0 0);">'>>
                        <<print '<span id="battery_value">'+_battery+'</span>'>>
                    </div>
                </div>
                <div id="phone-content" class="phone-content">
                    <<set _break to 0>>
                    <<for _app_name, _app range PhoneMod.Apps>>
                        <<if $Phone.CurrentApp is _app_name>>
                            <<print '<<'+_app.app_widget+'>>'>>
                            <<set _break to 1>>
                            <<break>>
                        <</if>>
                    <</for>>
                    <<if !_break>>
                        <div class="phone-desktop">
                            <<phone_wallpaper>>
                            <<for _app_name, _app range PhoneMod.Apps>>
                                <<if !_app.dlock or (_app.dlock and V.Phone.LockedApps.includes(_app_name))>>  <!-- 检测是否安装了此软件 -->
                                    <<if (_app.disable and _app.disable.includes($passage)) or (_app.disableinevent and V.event)>>  <!-- 检测此软件是否可用 -->
                                        <<print `
                                        <div class="phone-app-icon phone-app-icon-disabled">
                                            <img class="icon" src=`+_app.icon+`>
                                            `+_app.display_name+`
                                        </div>
                                        `>>
                                    <<else>>
                                        <<print `
                                        <div class="phone-app-icon" onclick="PhoneMod.toggleApp('`+_app_name+`')">
                                            <img class="icon" src=`+_app.icon+`>
                                            `+_app.display_name+`
                                        </div>
                                        `>>
                                    <</if>>
                                <</if>>
                            <</for>>
                        </div>
                    <</if>>
                </div>
                <div class="phone-tool-bar">
                    <<if !$Phone.PhotoCurrent>>
                        <span onclick="PhoneMod.toggleApp('main')" style="cursor:pointer">
                            <img class="toolbar-icon" src="img/ui/phone/home.png">
                        </span>
                    <</if>>
                    <span onclick="PhoneMod.togglePhone()" style="cursor:pointer">
                        <img class="toolbar-icon" src="img/ui/phone/lock.png">
                    </span>
                </div>
            <</if>>
        </div>
    </div>
<</widget>>

<<widget "smartphone_popup">>
    <div class="phone-popup" onclick="PhoneMod.msgClick(event)">
        <div class="phone-popup-content"></div>
        <div class="customOverlayClose" onclick="PhoneMod.msgClose()">
        </div>
    </div>
<</widget>>

<<widget "phone_wallpaper">>
    <<if $Phone.Settings.WallpaperPath>>
        <img id="phone-wallpaper" @src=$Phone.Settings.WallpaperPath>
        <<if $Phone.Settings.WallpaperBlur>>
            <div id="phone-wallpaper-cover" class="blur"></div>
        <</if>>
        <<if $Phone.Settings.WallpaperBlack>>
            <div id="phone-wallpaper-cover" class="black"></div>
        <</if>>
    <</if>>
<</widget>>

<<widget "phone_dialog">>
    <div id="phone-dialog">
        <div style="font-size: x-large; font-weight: bold;">
            _args[0]
        </div>
        <p>_args[1]</p>
        <<button "确定">><<run _dialog_func()>><<run document.querySelector("#phone-dialog")?.remove()>><</button>><br>
        <<button "取消">><<run document.querySelector("#phone-dialog")?.remove()>><</button>>
    </div>
<</widget>>


:: SmartPhoneAppWidgets [widget]
<<widget "phone_app_photo">>
    <<if $Phone.PhotoCurrent>>
        <div class="app-content" style="overflow-y: hidden">
            <div id="photo" style="display: flex; justify-content: space-evenly;"> 
                <img class="photo-image" @src=$Phone.PhotoCurrent.img onerror="javascript:this.src='img/photo/photonone.png'">
            </div>
            <div id="photo_ui" style="display: flex; justify-content: space-evenly;"> 
                <div id="photo_take_button_outline" style="position: absolute; bottom: 40px; width: 60px; height: 60px; background-color: transparent; border: 2px solid #fff; border-radius: 50%;">
                    <div id="photo_take_button" onclick="PhoneMod.photoSubmit()" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 55px; height: 55px; background-color: #fff; border-radius: 50%;"> </div>
                </div>
            </div>
        </div>
    <<else>>
        <h3>摄像</h3>
        <p style="font-size:12px; color:#666;">得找点什么拍，尝试去做一点有“意义”的事情吧！</p>
        <<link 前往相册>><<run PhoneMod.toggleApp("album")>><</link>><span style="font-size:12px; color:#666;">查看值得拍照的事件</span>
    <</if>>
<</widget>>

<<widget "phone_app_album">>
    <h3>相册</h3>
    <div class="album-content-container">
        <span class="def" id="photononetip" style="display:none">某些甚至全部的摄像图像将不可见</span>
        <ul class="todo-list"></ul>
    </div>
<</widget>>

<<widget "phone_app_contacts">>
    <h3>通讯录</h3>
    <div class="app-content">
        <<if validArray($Phone.KnownContacts)>>
            <div class="phone-contact-list">
                <<for _i range $Phone.KnownContacts>>
                    <div class="phone-contact-item">
                        <<set _contact to PhoneMod.getContact(_i)>>
                        <<if _contact>>
                            <span style="white-space: nowrap; margin-right: 10px">_contact.name</span>
                            <<button "呼叫 (0:05)" _contact.call>>
                                <<run PhoneMod.PhoneTo()>>
                                <<pass 5>>
                            <</button>>
                        <</if>>
                    </div>
                <</for>>
            </div>
        <<else>>
            <p style="font-size:12px; color:#666;">暂无联系人，你可以尝试去询问他们的电话号码。</p>
        <</if>>
    </div>
<</widget>>

<<widget "phone_app_alarm">>
    <h3>设定闹钟</h3>
    <div style="display: flex; flex-direction: column; gap: 10px;">
        <div>
            <label>
                <input type="radio" name="alarm-type" value="today" checked onclick="PhoneMod.toggleAlarmType('today')">仅限今天
            </label>
            <label>
                <input type="radio" name="alarm-type" value="weekly" onclick="PhoneMod.toggleAlarmType('weekly')">每周重复
            </label>
            <label>
                <input type="radio" name="alarm-type" value="date" onclick="PhoneMod.toggleAlarmType('date')">指定日期
            </label>
        </div>

        <!-- 星期输入 -->
        <div id="weekly-input" style="display: none;">
            <div>星期: 
                <div>
                    <label><input type="checkbox" name="weekday" value="2"> 周一</label>
                    <label><input type="checkbox" name="weekday" value="3"> 周二</label>
                    <label><input type="checkbox" name="weekday" value="4"> 周三</label>
                </div>
                <div>
                    <label><input type="checkbox" name="weekday" value="5"> 周四</label>
                    <label><input type="checkbox" name="weekday" value="6"> 周五</label>
                    <label><input type="checkbox" name="weekday" value="0"> 周六</label>
                    <label><input type="checkbox" name="weekday" value="1"> 周日</label>
                </div>
            </div>
        </div>
        <!-- 日期输入 -->
        <div id="phone-alarm-date" style="display: none;">
            <div>日期: <input type="date" id="phone-alarm-date-input"></div>
        </div>

        <div>时间: <input type="time" id="phone-alarm-time"></div>
        <input type="text" id="phone-alarm-msg" placeholder="备注">

        <<button "确认">><<run PhoneMod.submitAlarm()>><</button>>
    </div>

    <div class="phone-alarm-list">
        <<if $Phone.Alarms>>
            <hr>
            <<for _i, _alarm range $Phone.Alarms>>
                <div class="phone-alarm-item">
                    <<if _alarm.active>>
                        <div>
                            <div class="phone-alarm-display-time"><<if _alarm.hour < 10>>0<</if>>_alarm.hour:<<if _alarm.minute < 10>>0<</if>>_alarm.minute</div>
                            <div class="phone-alarm-display-msg"><<print PhoneMod.getAlarmDesc(_alarm)>> <<if _alarm.msg>> | _alarm.msg<</if>></div>
                        </div>
                    <<else>>
                        <div style="color: gray">
                            <div class="phone-alarm-display-time"><<if _alarm.hour < 10>>0<</if>>_alarm.hour:<<if _alarm.minute < 10>>0<</if>>_alarm.minute</div>
                            <div class="phone-alarm-display-msg"><<print PhoneMod.getAlarmDesc(_alarm)>> <<if _alarm.msg>> | _alarm.msg<</if>> | 已失效</div>
                        </div>
                    <</if>>
                    
                    <div style="white-space: nowrap;">
                        <<print '<<link "编辑">><<run PhoneMod.editAlarm('+_i+')>><</link>>'>>
                        <<print '<<link "删除">><<run PhoneMod.deleteAlarm('+_i+')>><</link>>'>>
                    </div>
                </div>
            <</for>>
        <</if>>
    </div>
<</widget>>

<<widget "phone_app_settings">>
    <h2>系统设置</h2>
    <hr>
    <h3>壁纸设置</h3>
    <<if $Phone.Settings.WallpaperPath eq undefined>>
        <<set $Phone.Settings.WallpaperBlur to 1>>
        <<set $Phone.Settings.WallpaperBlack to 1>>
    <</if>>
    <<if $Phone.Settings.WallpaperPath>>
        壁纸图像  <<link "重置壁纸">><<run PhoneMod.resetWallpaper()>><</link>><br>
        <<print `<img id="phone-wallpaper-preview" @src=$Phone.Settings.WallpaperPath>`>>
    <</if>>
    <input type="file" 
        id="phome-wallpaper-upload" 
        accept="image/*,.gif,.jpg,.jpeg,.png,.webp"
        onchange="PhoneMod.handleWallpaperUpload(this)"><br><br>
    <<print `<input type="checkbox" onclick="V.Phone.Settings.WallpaperBlur = this.checked" ` + ($Phone.Settings.WallpaperBlur ? "checked" : "") + `> 模糊效果`>>
    <span style="margin-right: 30px"></span>
    <<print `<input type="checkbox" onclick="V.Phone.Settings.WallpaperBlack = this.checked" ` + ($Phone.Settings.WallpaperBlack ? "checked" : "") + `> 加黑效果`>>
    <hr>
    <!-- <h3>使用设置</h3>
    <<print `<label><input type="checkbox" onclick="V.Phone.Settings.CanUsePhoneInAllAreas = this.checked" ` + ($Phone.Settings.CanUsePhoneInAllAreas ? "checked" : "") + `> 可以在非主要区域中使用</label>`>><br>
    <span class="black" style="font-size: small">【实验性！】主要区域是指DoL原版指定的最安全的区域，在这些区域，不会拥有<b class="red">存档破坏性事件</b>。而当玩家处于某些非主要区域时，一旦玩家在执行某一项活动中，<b class="teal">使用游戏、网购等跳转页面的功能时</b>，可能会破坏当前上下文，导致你的存档被破坏。<br>
    当然，开启此选项的风险并不大，但仍然建议谨慎使用。</span><br>
    <<print `<label><input type="checkbox" onclick="V.Phone.Settings.CanUsePhoneInEvent = this.checked" ` + ($Phone.Settings.CanUsePhoneInEvent ? "checked" : "") + `> 可以在事件中使用</label>`>><br>
    <span class="black" style="font-size: small">【实验性！】DoL中的事件貌似判定为只要有NPC出现就属于事件，<b class="teal">当你使用游戏、网购等跳转页面的功能时</b>，非常有可能会触发endevent！一旦如此，那么你正在触发的事件的<b class="red">NPC都会被清除</b>，正常剧情也会报错！</span><br>
    <hr> -->
    <h3>其他设置</h3>
    <<print `<input type="checkbox" onclick="V.Phone.Settings.NotificationClose = this.checked" ` + ($Phone.Settings.NotificationClose ? "checked" : "") + `> 关闭所有通知`>><br>
    <<link "重置教程进度">><<run PhoneMod.Guide.resetGuide()>><</link>><br>
<</widget>>

<<widget "phone_app_memo">>
    <h2>备忘录</h2>
    <div class="footer-actions">
        <input type="text" id="new_task_text" placeholder="输入任务文本" onkeydown="if (event.keyCode === 13) {PhoneMod.addNewMemoTask()}">
        <button onclick="PhoneMod.addNewMemoTask()">+ 新建任务</button>
        <button id="memo_enable_sort" onclick="PhoneMod.memoToggleEnableSort()">自动排序</button>
    </div>
    <ul class="todo-list" style="overflow: hidden;"></ul>
<</widget>>

<<widget "phone_app_game">>
    <<set $Phone.ReturnPassageTmp to passage()>>
    玩家在非活动期间可以游玩游戏| 大幅消耗时间<<ggtiredness>><<llstress>><<lltrauma>><<ggcontrol>>
    <br><br>
    游戏分为科学、数学、语文和历史四类，对应着学校的四门学科，相应更高的成绩能够取得更好的治愈效果，而且不论怎样，都可以少量提高相应学科的进度。
    <br><br>

    <<scienceicon>><<link [[玩科学实验室 (0:30)|Phone Game Science]]>><<run PhoneMod.PhoneTo()>><</link>><<gscience>>
    <br>
    <<mathicon>><<link [[玩数字天堂 (0:30)|Phone Game Maths]]>><<run PhoneMod.PhoneTo()>><</link>><<gmaths>>
    <br>
    <<englishicon>><<link [[玩文悦 (0:30)|Phone Game English]]>><<run PhoneMod.PhoneTo()>><</link>><<genglish>>
    <br>
    <<historyicon>><<link [[玩古识今知 (0:30)|Phone Game History]]>><<run PhoneMod.PhoneTo()>><</link>><<ghistory>>
<</widget>>

<<widget "phone_app_shop">>
    <<run PhoneMod.PhoneTo()>>
    <<set $Phone.CurrentApp to 'main'>>
    <<run PhoneMod.PhoneSafeCloseFinish()>>
    <<set $Phone.ReturnWorn to $worn>>
    <<goto 'Phone Shop'>>
<</widget>>

<<widget "phone_app_yenote">>
    <div class="yenote-status-bar">
        <div style="width: 100%; display: flex; align-items: center;">
            <<set _user to PhoneMod.getUser("{PC}")>>
            <img class="yenote-avatar pointer" @src=_user.avatar onclick="PhoneMod.yenoteResetAvatar()" onerror="javascript:this.src='img/misc/icon/phone/avatar/pc.png'">
            <input class="file-upload" type="file" accept="image/*" name="picture" style="display: none" onchange="PhoneMod.handleYenoteAvatarUpload(this)"/>
            <<if _user.name>>
                <span class="yenote-username pointer" onclick="PhoneMod.yenoteRename()">_user.name</span>
            <</if>>
        </div>
        <img class="yenote-title" src="img/misc/icon/phone/app/yenote_text_full.png">
        <img class="yenote-add pointer" src="img/ui/phone/app/add.png" onclick="PhoneMod.yenotePosting()">
    </div>
    <<if !$Phone.yenoteUsername>>
        <div class="note-rename">
            <b>开始你的旅途；记录性福生活。欢迎来到「小黄书」，告诉我们你的名字吧：</b>
            <div class="note-rename-actions">
                <input type="text" id="new_yenote_username" 
                       placeholder="输入你的名字" @value=PhoneMod.generateNickname()
                       onkeydown="if (event.keyCode === 13) {PhoneMod.yenoteSetNewName()}">
                <button onclick="PhoneMod.yenoteSetNewName()">确定</button>
            </div>
        </div>
    <<elseif $Phone.yenotePosting>>
        <<set _note to $Phone.yenotePosting>>
        <h3>发布你的文章</h3>
        <<if _note is true>>
            <textarea id="yenoteposttextarea" class="body-textarea" placeholder="写下你的故事…" aria-label="文章正文"></textarea>
            <div class="upload-area" role="button" aria-label="上传照片区域" tabindex="0" onclick="PhoneMod.toggleApp('album')">
                <div class="plus-icon">+</div>
            </div>
        <<else>>
            <div class="note-content">
                <div>
                    <div>
                        吸引度：<<print Math.round(_note.attract*100)>>%
                    </div>
                    <div class="meter">
                        <<set _percent to _note.attract * 100>>
                        <<if _percent gte 90>>
                            <<set _statColor to "greenbar">>
                        <<elseif _percent gte 80>>
                            <<set _statColor to "tealbar">>
                        <<elseif _percent gte 60>>
                            <<set _statColor to "lbluebar">>
                        <<elseif _percent gte 40>>
                            <<set _statColor to "bluebar">>
                        <<elseif _percent gte 20>>
                            <<set _statColor to "purplebar">>
                        <<elseif _percent gte 10>>
                            <<set _statColor to "pinkbar">>
                        <<else>>
                            <<set _statColor to "redbar">>
                        <</if>>
                        <div @class="_statColor" @style="'width:' + _percent + '%'"></div>
                    </div>
                    <div id="yenote_heat">
                    </div>
                    <div>
                        定价：<span id="price_text" class="gold">免费</span>
                    </div>
                    <input type="range" id="price_input" value="0" min="0" @max="_note.attract*100" step="1" onchange="PhoneMod.yenoteChangePrice()">
                    <<run setTimeout(PhoneMod.yenoteChangePrice, 10)>>
                </div>
                <br>
                <div class="note-passage">
                    <<print _note.msg>>
                </div>
                <br>
                <div class="note-image-container">
                    <img class="note-image" @src=_note.img onerror="javascript:this.remove()">
                </div>
            </div>
        <</if>>
        <div class="note-rename-actions">
            <button onclick="PhoneMod.yenotePostCancel()">取消</button>
            <div>
                <button onclick="PhoneMod.yenotePostSubmit()">确定发布</button>
            </div>
        </div>
    <<else>>
        <div class="note-content-container">
            <<if validArray($Phone.Yenotes)>>
                <<for _note range $Phone.Yenotes>>
                    <<capture _note>>
                        <div class="yenote-content">
                            <<set _user to PhoneMod.getUser(_note.name)>>
                            <div class="note-avatar">
                                <img class="yenote-avatar yenote-note" @src=_user.avatar onerror="javascript:this.src='img/misc/icon/phone/avatar/pc.png'">
                            </div>
                            <div class="note-content">
                                <div class="note-title">
                                    <b>_user.name</b>
                                    <<if _note.price>>
                                        <img class="note-premium" src="img/ui/phone/app/premium.png">
                                    <</if>>
                                </div>
                                <div class="note-passage">
                                    <<print _note.msg>>
                                </div>
                                <div class="note-image-container">
                                    <<if _note.img isnot null>>
                                        <<print '<img class="note-image'+ (_note.price? ' locked': '') +'" @data-id=_note.id @src=_note.img onerror="javascript:this.parentElement.remove()">'>> 
                                        <<if _note.price>>
                                            <div class="note-locked-text">付费内容</div>
                                        <</if>>
                                    <</if>>
                                </div>
                                <div class="note-info"> 
                                    <<if _note.npc>>
                                        <<print '点赞'+_note.like+"&nbsp;&nbsp;">> 
                                        <<if _note.price>>
                                            <<print '定价<span class="gold">£'+_note.price+'</span>&nbsp;&nbsp;'>>
                                            <<if !_note.unlocked>>
                                                <<link "购买文章">><<run PhoneMod.yenoteUnlock(_note.id)>><</link>>
                                            <</if>>
                                        <</if>>
                                    <<else>>
                                        <<print '阅读'+_note.view+'&nbsp;&nbsp;点赞'+_note.like+"&nbsp;&nbsp;">> 
                                        <<if _note.earned>><<print '获利<span class="gold">£'+_note.earned+'</span>&nbsp;&nbsp;'>><</if>> 
                                        <<link "删除此文章">><<run PhoneMod.yenoteDelete(_note.id)>><</link>>
                                    <</if>>
                                </div>
                                <<if validArray(_note.comments)>>
                                    <div class="note-commends">
                                        <details class="note-comment-foldable" open>
                                            <summary><<print _note.comments.length+"条评论">></summary>
                                            <<for _comment range _note.comments>>
                                                <div class="note-comments-name">
                                                    <b><<print _comment.name>></b> <<print _comment.last_name? "回复 "+_comment.last_name: "">>
                                                </div>
                                                <div @id='_note.id+"*"+_note.comments.indexOf(_comment)' class="note-comment">
                                                    <<print _comment.text>>
                                                </div>
                                            <</for>>
                                        </details>
                                    </div>
                                <</if>>
                            </div>
                        </div>
                    <</capture>>
                <</for>>
            <<else>>
                <p style="font-size:12px; color:#666;">你可以成为你的圈子里第一个发小黄书的人！</p>
            <</if>>
        </div>
    <</if>>
    <!-- <div class="yenote-tool-bar">
    </div> -->
<</widget>>

<<widget "phone_app_map">>
    <div class="control-panel">
        <div class="slider-group">
            <div class="slider-header"><span>深入进度</span> <span id="forestVal">20</span></div>
            <input type="range" id="forestSlider" min="0" max="100" value="20" step="1">
        </div>
    </div>

    <div class="depth-ruler" id="rulerContainer"></div>

    <div class="info-box" id="infoPanel"></div>
<</widget>>

<<widget "renderRecipeList">>
    <<set _list to _args[0]>>
    <<set _title to _args[1]>>
    <<set _isCantLearn to _args[2]>>
    
    <<if _title>>
        <h3>_title</h3>
    <</if>>
    
    <<for _item range _list>>
        <<capture _item>>
            <<if $options.images is 1 and _item.icon>>
                <img class="tending_icon" @src="`img/misc/icon/tending/` + _item.icon">
            <</if>>
            <<print "原料: "+_item.ingredients>>
            
            <<if _isCantLearn>>
                <<button "无法学习 _item.name (需求家务 _item.required)">><</button>>
            <<else>>
                <<if _item.hasLearned>>
                    <<button "继续学习 _item.name (_item.tt) (_item.hasLearned/_item.difficulty)" "Phone NewWest">>
                        <<pass _item.t>>
                        <<run PhoneMod.PhoneTo()>>
                        <<set $food_to_learn to _item.key>>
                    <</button>>
                <<else>>
                    <<button "开始学习 _item.name (_item.tt)" "Phone NewWest">>
                        <<pass _item.t>>
                        <<run PhoneMod.PhoneTo()>>
                        <<set $food_to_learn to _item.key>>
                    <</button>>
                <</if>>
            <</if>>
        <</capture>>
    <</for>>
<</widget>>

<<widget "phone_app_newWest">>
    <h2>美食屋</h2>
    <<set _lst to PhoneMod.getRecipes()>>
    <<set _lst_learning to _lst[0]>>
    <<set _lst_unlearning to _lst[1]>>
    <<set _lst_cantlearning to _lst[2]>>
    
    <!-- 学习中的食谱 -->
    <<if _lst_learning.length gt 0>>
        <<renderRecipeList _lst_learning "学习中的食谱" false>>
        <hr>
    <</if>>
    
    <!-- 可学习的食谱 -->
    <<if _lst_unlearning.length gt 0>>
        <<renderRecipeList _lst_unlearning "可学习的食谱" false>>
        <hr>
    <</if>>
    
    <!-- 无法学习的食谱 -->
    <<if _lst_cantlearning.length gt 0>>
        <<renderRecipeList _lst_cantlearning "无法学习的食谱" true>>
        <hr>
    <</if>>
<</widget>>


:: Smartphone Debug [widget]
<<widget "smartphone_debug_switch">>
    <div id="smart-phone-debug-switch" onclick="PhoneMod.toggleDebug()">
        <<icon "phone/phone.png">>
        <span style="position: absolute; right: 15px; top: 20px; font-size: 5px; background-color: black;"><<print PhoneMod.currentVersion.replace("Alpha", "A");>></span>
    </div>
<</widget>>

<<widget "smartphone_debug">> <div id="smart-phone-debug-container">
    <div id="smartphone_debug_msg"></div>
    <br><br><br>
    <<link "刷新">><<run PhoneMod.toggleDebug(true)>><</link>> | <<link "刷新段落">><<run Engine.play(passage())>><</link>><br>
    <input type="text" id="excute-js" placeholder="执行js命令"><<link "执行">><<run PhoneMod.DebugExcuteJs()>><</link>>
    <hr>
    <input type="text" id="excute-sugercube-path" placeholder="执行位置 ?? #smartphone_debug_msg">
    <input type="text" id="excute-sugercube" placeholder="执行SugerCube命令"><<link "执行">><<run PhoneMod.DebugExcuteSugerCube()>><</link>>
    <hr>
    <h3 class="gold">获取手机</h3>
    <<link "通过官方店购买手机">><<run PhoneMod.BuyPhone("特斯特2 测试型")>><<run Engine.play(passage())>><</link>><br>
    <<link "通过老冯购买手机">><<run PhoneMod.BuySecondPhone("特斯特2 测试型", 0.8)>><<run Engine.play(passage())>><</link>><br>
    <<link "通过盗窃获得手机">><<run PhoneMod.StolePhone()>><<run Engine.play(passage())>><</link>><br>
    <<link "修复当前使用的手机">><<run PhoneMod.getUsingPhone().newness = PhoneMod.getUsingPhone().newnessmax>><<run Engine.play(passage())>><</link>>
    <hr>
    <h3 class="gold">剧情变量</h3>
    <<link "清空咖啡店盗窃警戒">><<run delete V.Phone.StealPhoneAlertOceanBreeze>><<run Engine.play(passage())>><</link>><br>
    <<link "刷新二手手机店货物">><<run PhoneMod.RefreshSecondPhone()>><<run Engine.play(passage())>><</link>><br>
    <<link "一键最高摄影技能">><<run V.Phone.photography = 1000>><</link>><br>
    <<link "一键解锁所有照片">><<run PhoneMod.photoTakeDebug()>><</link>>
    <hr>
    <h3 class="gold">调试对话</h3><span class="red">注意！这可能会破坏你的存档 至少会改变你的位置</span><br>
    <<link [[进入官方店|Shopping Centre Phone Shop]]>><</link>><br>
    <<link [[进入地下手机店|Second Phone Shop]]>><</link>><br>
    <<link [[触发老冯初见面对话|Second Phone Shop Meet Feng First]]>><</link>><br>
    <hr>
    <h3 class="teal">变量 V.Phone</h3>
    <<for _key, _value range $Phone>>
        <<if PhoneMod.debugBlackVPhone.contains(_key)>>
            <<print "<b class='teal'>"+_key+"</b> <span class='green'>已设置</span>">><br>
        <<else>>
            <<print "<b class='teal'>"+_key+"</b> "+JSON.stringify(_value)>><br>
        <</if>>
    <</for>>
    <hr>
    <br><br><br>
</div> <</widget>>

:: Smartphone Guide [widget]
<<widget "smartphone_guide">> <div id="smartphone_guide">
    <div id="tutorial-overlay" class="tutorial-overlay hidden">
        <div class="tutorial-container">
            <!-- 关闭按钮 -->
            <button class="tutorial-close" onclick="PhoneMod.Guide.closeTutorial()">✕</button>
            
            <!-- 教程内容区域 -->
            <div class="tutorial-content" id="tutorialContent">
                <!-- 步骤指示器 -->
                <div id="tutorialSteps" class="tutorial-steps">
                </div>
                
                <!-- 图片区域 -->
                <div class="tutorial-image-container">
                    <img id="tutorialImage" class="tutorial-image" src="" alt="教程图片">
                </div>
                
                <!-- 文字区域 -->
                <div id="tutorialText" class="tutorial-text">
                    <!-- 动态填充内容 -->
                </div>
                
                <!-- 导航按钮 -->
                <div class="tutorial-nav">
                    <button id="prevBtn" class="tutorial-btn prev-btn" onclick="PhoneMod.Guide.prevStep()" disabled>上一步</button>
                    <div class="tutorial-progress">
                        <span id="currentStep">1</span>/<span id="totalSteps">-</span>
                    </div>
                    <button id="nextBtn" class="tutorial-btn next-btn" onclick="PhoneMod.Guide.nextStep()">下一步</button>
                </div>
            </div>
        </div>
    </div>
</div> <</widget>>